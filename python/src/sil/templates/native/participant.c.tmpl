/* $name: a Native participant, written by `sil new participant --native`.
 *
 * The kernel loads this shared library and calls sil_participant_init once
 * (`sil docs adas-reference` describes the C ABI). The participant registers
 * one periodic task. At each activation it publishes one `$name.Out` Message
 * on the Channel `$name.out`. Replace `step` with the behavior of your system
 * under test.
 *
 * The Participant contract applies: no wall-clock reads and no free-running
 * threads. All behavior must come from the virtual time and the Messages the
 * task takes, or two Runs of the same Manifest give different Recordings and
 * `sil check` fails.
 */
#include <stdint.h>
#include <stdlib.h>

#include <sil/participant.h>

#define STEP_PERIOD_NS 10000000u

/* The payload of `$name.Out`: packed little-endian fields in Schema order.
 * For a larger Schema, generate the struct with `silschema`. */
typedef struct {
  uint64_t step;
} out_message;

/* The state of one participant, behind the user pointer of its task. */
struct participant {
  const sil_api_v1 *api;
  uint64_t step;
};

static void step(void *user, uint64_t now_ns) {
  struct participant *self = user;
  (void)now_ns;
  out_message message = {self->step++};
  if (self->api->publish(self->api->ctx, "$name.out", &message,
                         sizeof message) != SIL_OK)
    self->api->fail(self->api->ctx, "cannot publish on $name.out");
}

int sil_participant_init(const sil_api_v1 *api, const char *name,
                         const char *config_json) {
  (void)name;
  (void)config_json; /* the participant's "config" object, as JSON */
  if (api->abi_version != SIL_ABI_VERSION) return SIL_ERR;
  struct participant *self = calloc(1, sizeof *self);
  if (!self) return SIL_ERR;
  self->api = api;
  return api->register_task(api->ctx, "step", STEP_PERIOD_NS, 0, 0, step,
                            self);
}
