# syntax=docker/dockerfile:1

# The ACC adoption example: the production SiL runtime image plus the consumer
# material that authors and judges its Runs. Nothing is compiled, exported or
# independently re-simulated here, so no build tool and no comparison importer
# enters this image. The model's only runtime dependency, CPython with
# libpython, already comes from the runtime image's own base.
ARG SIL_RUNTIME_IMAGE
FROM ${SIL_RUNTIME_IMAGE}

USER root

# Named one by one: the exporter, the independent FMPy drivers, the archive
# audits and the gate tests deliberately stay out of an installed bundle.
COPY proofs/acc-fmi/acceptance.py \
     proofs/acc-fmi/acceptance_bundle.py \
     proofs/acc-fmi/acceptance_contract.py \
     proofs/acc-fmi/acceptance_verdict.py \
     proofs/acc-fmi/proof_support.py \
     proofs/acc-fmi/scenarios.py \
     proofs/acc-fmi/scenario_contract.py \
     proofs/acc-fmi/scenario_participant.py \
     proofs/acc-fmi/sensitivity_compare.py \
     proofs/acc-fmi/sensitivity_contract.py \
     proofs/acc-fmi/sensitivity_kpi.py \
     proofs/acc-fmi/sensitivity_maneuver.py \
     proofs/acc-fmi/sensitivity_manifest.py \
     /opt/acc-example/

# The pinned bundle and its archives are copied in before the Run; the
# evidence is copied out of /workspace after it. Both Manifest-visible paths
# are fixed and belong to this example image, so a Manifest authored here is
# the one preparation was pinned against. The supported container surface is
# the one SUPPORT.md names: the `sil-run` entry point, `/workspace`, and the
# non-root UID. No installation path inside the runtime image is relied on.
RUN install -d -o 10001 -g 10001 /bundle /fmus

USER 10001:10001
ENV SIL_ACC_RUNNER=sil-run
WORKDIR /workspace
