{
  "sil_bundle": 1,
  "name": "native-crash",
  "artifacts": {
    "libsafety_native.so": "target",
    "libsafety.so": "target",
    "native-window.mcap": "recording",
    "transmit-window.mcap": "recording",
    "native-crash.json": "manifest"
  },
  "runtime": {
    "runner": "sil-run",
    "environment": {
      "PATH": "/usr/local/bin:/usr/bin:/bin",
      "TMPDIR": "/workspace/tmp/native-crash"
    }
  },
  "dependencies": {
    "files": [
      "/lib/x86_64-linux-gnu/libc.so.6",
      "/lib/x86_64-linux-gnu/libgcc_s.so.1",
      "/lib/x86_64-linux-gnu/libm.so.6",
      "/lib/x86_64-linux-gnu/libstdc++.so.6",
      "/lib/x86_64-linux-gnu/libubsan.so.1",
      "/lib64/ld-linux-x86-64.so.2"
    ]
  },
  "excluded": {
    "executables": [
      "cc",
      "gcc",
      "clang",
      "c++"
    ]
  },
  "runs": [
    {
      "name": "native-crash",
      "manifest": "native-crash.json",
      "determinism": false
    }
  ]
}
