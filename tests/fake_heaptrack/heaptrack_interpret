#!/usr/bin/env python3
"""A stand-in for heaptrack_interpret: it copies stdin to stdout.

The fake preload library writes interpreted data directly. With
FAKE_HEAPTRACK_INTERPRET_EXIT set it ends with that exit code after the
copy; with FAKE_HEAPTRACK_INTERPRET_HANG it never ends.
"""

import os
import sys
import time

for block in iter(lambda: sys.stdin.buffer.read1(65536), b""):
    sys.stdout.buffer.write(block)
sys.stdout.buffer.flush()
if os.environ.get("FAKE_HEAPTRACK_INTERPRET_HANG"):
    while True:
        time.sleep(1)
sys.exit(int(os.environ.get("FAKE_HEAPTRACK_INTERPRET_EXIT", "0")))
